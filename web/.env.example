# Copie para .env.local e preencha. Nunca envie o .env.local para o GitHub.

# Banco (Neon): o endereço com "-pooler" para o app e o direto para as migrações.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login (Better Auth): um segredo longo e aleatório, e o endereço do app.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# IA (OpenAI): sem a chave, o Pollo CEO responde em demonstração.
OPENAI_API_KEY=
# Limite de gasto de IA por empresa por mês, em US$ (padrão 5).
AI_MONTHLY_LIMIT_USD=5
